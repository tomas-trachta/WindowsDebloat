<Window x:Class="WindowsDebloat.RevertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revert changes" Width="640" Height="520" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#FF15171C"
        FontFamily="Segoe UI" FontSize="13" Foreground="#FFE8E8E8">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#FF1D2026"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#FF30343D"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="Background" Value="#FF2A2E36"/>
      <Setter Property="BorderBrush" Value="#FF3C414C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF3A3F4A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Revert changes" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Grid.Row="1" Foreground="#FF9BA3AF" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Pick a snapshot below. Registry, service and scheduled-task changes from that run will be undone. Removed apps are not reinstalled - get those back from the Microsoft Store."/>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="42*" MinWidth="180"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="58*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1" CornerRadius="6">
        <ListBox x:Name="SnapshotList" Background="Transparent" BorderThickness="0" Foreground="#FFE8E8E8"
                 Margin="4" SelectionChanged="SnapshotList_SelectionChanged"/>
      </Border>

      <Border Grid.Column="2" Background="#FF0F1115" BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1" CornerRadius="6">
        <TextBox x:Name="LogBox" Background="Transparent" Foreground="#FFB9C2CE" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="10"
                 Text="Select a snapshot on the left to see what it would undo.&#10;"/>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnClose" Content="Close" Margin="0,0,8,0" Click="BtnClose_Click"/>
      <Button x:Name="BtnRevert" Content="Revert this snapshot" Background="#FF7A2E2E" BorderBrush="#FF7A2E2E"
              IsEnabled="False" Click="BtnRevert_Click"/>
    </StackPanel>
  </Grid>
</Window>
