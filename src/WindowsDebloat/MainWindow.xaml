<Window x:Class="WindowsDebloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Windows Debloat Toolkit" Width="1100" Height="740" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FF15171C"
        FontFamily="Segoe UI" FontSize="13" Foreground="#FFE8E8E8"
        Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#FF1D2026"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#FF30343D"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="Background" Value="#FF2A2E36"/>
      <Setter Property="BorderBrush" Value="#FF3C414C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF3A3F4A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Windows Debloat Toolkit" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="OsText" FontSize="13" Foreground="#FF9BA3AF" Margin="14,10,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30*" MinWidth="430"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="26*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1" CornerRadius="6">
        <DockPanel Margin="10">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,8">
            <Button x:Name="BtnRecommended" Content="Select recommended" Margin="0,0,8,0" Click="BtnRecommended_Click"/>
            <Button x:Name="BtnAll" Content="Select all" Margin="0,0,8,0" Click="BtnAll_Click"/>
            <Button x:Name="BtnNone" Content="Select none" Click="BtnNone_Click"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TaskPanel" Margin="2,0,12,4"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="6" Padding="12">
          <StackPanel>
            <TextBlock Text="Options" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkRestorePoint" Content="Create a System Restore point first (recommended)"
                      IsChecked="True" Margin="0,2,0,5"/>
            <CheckBox x:Name="ChkRestartExplorer" Content="Restart Explorer when finished (applies taskbar/Start changes)"
                      IsChecked="True"/>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="1" Value="0"
                         Background="#FF22252C" BorderBrush="{StaticResource PanelBorder}"/>
            <TextBlock x:Name="StatusText" Foreground="#FF9BA3AF" Margin="0,6,0,0" Text="Ready."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnRevert" Content="Revert..." FontSize="13" Padding="14,9" Margin="14,0,0,0" Click="BtnRevert_Click"/>
            <Button x:Name="BtnRun" Content="Apply selected" FontSize="15" FontWeight="SemiBold"
                    Background="#FF2F81F7" BorderBrush="#FF2F81F7" Padding="22,9" Margin="8,0,0,0" Click="BtnRun_Click"/>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#FF0F1115" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="6">
          <TextBox x:Name="LogBox" Background="Transparent" Foreground="#FFB9C2CE" BorderThickness="0"
                   FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Padding="10"
                   Text="Select tasks on the left, then click Apply selected.&#10;"/>
        </Border>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Margin="2,10,2,0" Foreground="#FF6F7681" FontSize="12" TextWrapping="Wrap"
               Text="Nothing here touches Windows Defender, Windows Update or UAC. Removed apps can be reinstalled from the Microsoft Store; the restore point is your undo button."/>
  </Grid>
</Window>
